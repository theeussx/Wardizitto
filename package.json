{
  "name": "wardizitto",
  "version": "2.0.0",
  "description": "Bot Discord modular para administração, economia, moderação e comunidades.",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "start:prod": "NODE_ENV=production node --enable-source-maps dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/infrastructure/database/cli.ts migrate",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run check:commands",
    "prepare": "husky",
    "check:commands": "node scripts/validate-commands.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "date-fns": "^4.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "figlet": "^1.11.4",
    "iso-639-1": "^3.1.6",
    "mathjs": "^15.2.0",
    "mysql2": "^3.23.3",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
