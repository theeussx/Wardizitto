# Runtime
NODE_ENV=development

# Discord
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_OWNER_IDS=123456789012345678
DISCORD_DEVELOPER_IDS=
DISCORD_GUILD_ID=123456789012345678
DISCORD_REGISTER_COMMANDS=true
DISCORD_GLOBAL_COMMANDS=false
DISCORD_ENABLE_PREFIX_COMMANDS=true
DISCORD_PREFIX=!
DISCORD_INTENT_GUILD_MEMBERS=true
DISCORD_INTENT_MESSAGE_CONTENT=true

# MySQL 8+
DB_HOST=localhost
DB_PORT=3306
DB_USER=wardizitto
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=wardizitto
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_MIGRATE_ON_START=true

# Logs, localization and abuse protection
LOG_LEVEL=info
LOG_DIRECTORY=logs
LOG_RETENTION_DAYS=30
DEFAULT_LOCALE=pt-BR
COMMAND_COOLDOWN_MS=3000
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=12
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RESPONSE_BYTES=10485760

# Optional integrations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VIRUSTOTAL_API_KEY=
WEBHOOK_LOGS_URL=

# Optional Discord resources
FAN_ART_REVIEW_CHANNEL_ID=
FAN_ART_PUBLIC_CHANNEL_ID=
BUG_REPORT_CHANNEL_ID=
STATUS_CHANNEL_ID=
MEMBER_COUNT_CHANNEL_ID=
SERVER_COUNT_GUILD_ID=
SERVER_COUNT_CHANNEL_ID=
DONATION_LOG_CHANNEL_ID=
VERIFICATION_ROLE_ID=

# Optional donations — never commit real financial data
PIX_KEY=
PIX_COPY_PASTE=
